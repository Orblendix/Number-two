import javax.swing.*;
import java.awt.*;

public class PasswordRegistration {

    public static void main(String[] args) {
        // 1) Окно приветствия и предложения зарегистрироваться
        int register = JOptionPane.showConfirmDialog(
            null,
            "Добро пожаловать! Хотите зарегистрироваться в программе?",
            "Регистрация",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.QUESTION_MESSAGE
        );

        if (register != JOptionPane.YES_OPTION) {
            JOptionPane.showMessageDialog(null, "До свидания!", "Выход", JOptionPane.INFORMATION_MESSAGE);
            return;
        }

        // 2) Окно ввода логина
        String login = "";
        boolean validLogin = false;
        while (!validLogin) {
            login = JOptionPane.showInputDialog(
                null,
                "Введите логин (больше 5 символов, без пробелов):",
                "Ввод логина",
                JOptionPane.QUESTION_MESSAGE
            );

            if (login == null) {
                JOptionPane.showMessageDialog(null, "Регистрация отменена.", "Отмена", JOptionPane.WARNING_MESSAGE);
                return;
            }

            // Проверка логина: длина > 5 и нет пробелов
            if (login.length() > 5 && !login.contains(" ")) {
                validLogin = true;
            } else {
                JOptionPane.showMessageDialog(
                    null,
                    "Ошибка! Логин должен быть длиннее 5 символов и не содержать пробелов.",
                    "Неверный логин",
                    JOptionPane.ERROR_MESSAGE
                );
            }
        }

        // 3) Окно ввода пароля
        String password = "";
        boolean validPassword = false;
        while (!validPassword) {
            // Создаём панель для ввода пароля со звёздочками
            JPanel panel = new JPanel(new BorderLayout());
            JLabel label = new JLabel("Введите пароль (больше 8 символов, без пробелов, хотя бы 1 буква и 1 цифра):");
            JPasswordField passwordField = new JPasswordField(20);
            panel.add(label, BorderLayout.NORTH);
            panel.add(passwordField, BorderLayout.CENTER);

            int result = JOptionPane.showConfirmDialog(
                null,
                panel,
                "Ввод пароля",
                JOptionPane.OK_CANCEL_OPTION,
                JOptionPane.QUESTION_MESSAGE
            );

            if (result != JOptionPane.OK_OPTION) {
                JOptionPane.showMessageDialog(null, "Регистрация отменена.", "Отмена", JOptionPane.WARNING_MESSAGE);
                return;
            }

            password = new String(passwordField.getPassword());

            // Проверка пароля
            boolean hasLetter = false;
            boolean hasDigit = false;
            for (char c : password.toCharArray()) {
                if (Character.isLetter(c)) hasLetter = true;
                if (Character.isDigit(c)) hasDigit = true;
            }

            if (password.length() > 8 && !password.contains(" ") && hasLetter && hasDigit) {
                validPassword = true;
            } else {
                JOptionPane.showMessageDialog(
                    null,
                    "Ошибка! Пароль должен быть:\n" +
                    "- длиннее 8 символов\n" +
                    "- без пробелов\n" +
                    "- содержать хотя бы одну букву\n" +
                    "- содержать хотя бы одну цифру",
                    "Неверный пароль",
                    JOptionPane.ERROR_MESSAGE
                );
            }
        }

        // 4) Окно подтверждения пароля
        boolean passwordsMatch = false;
        while (!passwordsMatch) {
            JPanel panel = new JPanel(new BorderLayout());
            JLabel label = new JLabel("Повторите пароль:");
            JPasswordField passwordField = new JPasswordField(20);
            panel.add(label, BorderLayout.NORTH);
            panel.add(passwordField, BorderLayout.CENTER);

            int result = JOptionPane.showConfirmDialog(
                null,
                panel,
                "Подтверждение пароля",
                JOptionPane.OK_CANCEL_OPTION,
                JOptionPane.QUESTION_MESSAGE
            );

            if (result != JOptionPane.OK_OPTION) {
                JOptionPane.showMessageDialog(null, "Регистрация отменена.", "Отмена", JOptionPane.WARNING_MESSAGE);
                return;
            }

            String confirmPassword = new String(passwordField.getPassword());

            if (password.equals(confirmPassword)) {
                passwordsMatch = true;
            } else {
                JOptionPane.showMessageDialog(
                    null,
                    "Ошибка! Пароли не совпадают.",
                    "Пароли не совпадают",
                    JOptionPane.ERROR_MESSAGE
                );
            }
        }

        // 5) Информационное окно об успешной регистрации
        JOptionPane.showMessageDialog(
            null,
            "Поздравляем, " + login + "!\nВы успешно зарегистрировались!",
            "Регистрация завершена",
            JOptionPane.INFORMATION_MESSAGE
        );
    }
}
