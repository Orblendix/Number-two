import javax.swing.JOptionPane;

public class ConfirmationDialog {

    public static void main(String[] args) {
        // Первый вопрос
        int answer1 = JOptionPane.showConfirmDialog(
            null,
            "Вы любите программировать?",
            "Вопрос 1",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.QUESTION_MESSAGE
        );

        // Второй вопрос
        int answer2 = JOptionPane.showConfirmDialog(
            null,
            "Вы любите кофе?",
            "Вопрос 2",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.QUESTION_MESSAGE
        );

        // Формируем ответ в зависимости от вариантов
        String resultMessage;

        if (answer1 == JOptionPane.YES_OPTION && answer2 == JOptionPane.YES_OPTION) {
            resultMessage = "Вы любите программировать и кофе!\n"
                          + "Вы — настоящий IT-шник! ☕💻";
        } 
        else if (answer1 == JOptionPane.YES_OPTION && answer2 == JOptionPane.NO_OPTION) {
            resultMessage = "Вы любите программировать, но не любите кофе.\n"
                          + "Возможно, вы предпочитаете чай или энергетики. 🍵💻";
        } 
        else if (answer1 == JOptionPane.NO_OPTION && answer2 == JOptionPane.YES_OPTION) {
            resultMessage = "Вы не любите программировать, но любите кофе.\n"
                          + "Наверное, вы работаете в другой сфере, но кофе уважаете. ☕😊";
        } 
        else {
            resultMessage = "Вы не любите программировать и не любите кофе.\n"
                          + "Возможно, вы любите спать и отдыхать. 😴🛌";
        }

        // Показываем итоговое информационное окно
        JOptionPane.showMessageDialog(
            null,
            resultMessage,
            "Результат опроса",
            JOptionPane.INFORMATION_MESSAGE
        );
    }
}
